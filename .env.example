# ===== Core =====
ENV=development
BASE_CURRENCY=AUD
TZ=Australia/Melbourne

# ===== Postgres / TimescaleDB =====
POSTGRES_USER=moneyball
POSTGRES_PASSWORD=moneyball_dev_password
POSTGRES_DB=moneyball
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://moneyball:moneyball_dev_password@postgres:5432/moneyball

# ===== Redis / Celery =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== Auth =====
JWT_SECRET=change_me_dev_only_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_dev_only

# ===== Frontend =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BASE_CURRENCY=AUD

# ===== Data sources — all optional, app must run with none of these set =====
# MLB Stats API (statsapi.mlb.com) — free, no key required.
# nba_api (stats.nba.com) — free, no key required, but rate-limit sensitive.
# Squiggle API (api.squiggle.com.au) — free, no key, requires a descriptive User-Agent.
SQUIGGLE_USER_AGENT=moneyball-dev (contact: jashk1010@gmail.com)

# football-data.org — free tier, 10 req/min, limited competitions.
FOOTBALL_DATA_API_KEY=

# API-Football (RapidAPI) — optional, free tier ~100 req/day. Leave blank to skip.
API_FOOTBALL_KEY=

# The Odds API — free tier 500 req/month. Leave blank to run on manual paste-in odds only.
ODDS_API_KEY=

# Open-Meteo — free, no key required.

# ===== Encryption for admin-stored API keys (Fernet key, 32 url-safe base64 bytes) =====
API_KEY_ENCRYPTION_SECRET=change_me_generate_a_real_fernet_key
